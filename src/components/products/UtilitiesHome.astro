---
import { getCollection } from 'astro:content';
interface Props {
  primaryHeading?: boolean;
}
const { primaryHeading = true } = Astro.props;
const [entry] = await getCollection('utilitiesSettings');
if (!entry) throw new Error('Utilities CMS settings are missing.');
const { home } = entry.data;
---
<div class="utility-page utility-home">
  <section class="utility-home-hero" aria-labelledby="utilities-heading">
    <span class="eyebrow">{home.hero.eyebrow}</span>
    {primaryHeading
      ? <h1 id="utilities-heading">{home.hero.heading}<br /><em>{home.hero.accent}</em></h1>
      : <h2 id="utilities-heading">{home.hero.heading}<br /><em>{home.hero.accent}</em></h2>}
    <p>{home.hero.intro}</p>
  </section>
  <section class="utility-tool-grid" aria-label="Video tools">
    {home.tools.map((tool) => <a href={tool.href}><span>{tool.number}</span><h2>{tool.title}</h2><p>{tool.description}</p><strong>{tool.linkLabel}</strong></a>)}
  </section>
  <section class="utility-privacy-strip">
    <div><span class="eyebrow">{home.privacyEyebrow}</span><h2>{home.privacyHeading}</h2></div>
    <p>{home.privacyBody}</p>
  </section>
</div>
