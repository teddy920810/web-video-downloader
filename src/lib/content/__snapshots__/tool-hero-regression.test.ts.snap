exports[`preserves the approved Hero markup and existing tool CMS content > components/products/UtilityToolPage.astro 1`] = `
"<section class="utility-hero" aria-labelledby={headingId}>
      <div class="utility-hero-copy">
        <span class="eyebrow">{page.hero.eyebrow}</span>
        <h1 id={headingId}>{page.hero.heading}<br /><em>{page.hero.accent}</em></h1>
        <p>{page.hero.intro}</p>
      </div>
      <slot />
    </section>"
`;

exports[`preserves the approved Hero markup and existing tool CMS content > pages/background-remover.astro 1`] = `
"<section class="utility-hero background-remover-hero" aria-labelledby="background-remover-heading">
      <div class="utility-hero-copy">
        <span class="eyebrow">{backgroundRemover.hero.eyebrow}</span>
        <h1 id="background-remover-heading">{backgroundRemover.hero.heading}<br /><em>{backgroundRemover.hero.accent}</em></h1>
        <p>{backgroundRemover.hero.intro}</p>
      </div>
      <BackgroundRemover client:only="react" copy={backgroundTool} />
    </section>"
`;

