---
import { getCollection } from 'astro:content';
import VideoMergerTool from '../components/media/VideoMergerTool';
import UtilityToolPage from '../components/products/UtilityToolPage.astro';
export const prerender = false;
const [entry] = await getCollection('utilitiesSettings');
if (!entry) throw new Error('Utilities CMS settings are missing.');
const page = entry.data.toolPages['video-merger'];
---
<UtilityToolPage page={page} siteMode={Astro.locals.siteMode} headingId="video-merger-heading"><VideoMergerTool client:only="react" /></UtilityToolPage>
