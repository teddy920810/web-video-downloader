---
import LocalVideoTool from '../components/media/LocalVideoTool';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;
const [entry] = await getCollection('utilitiesSettings');
if (!entry) throw new Error('Utilities CMS settings are missing.');
const { converter, tool } = entry.data;
---

<SiteLayout siteMode={Astro.locals.siteMode} title={converter.meta.title} description={converter.meta.description}>
  <div class="utility-page">
    <section class="utility-hero" aria-labelledby="converter-heading">
      <div>
        <span class="eyebrow">{converter.hero.eyebrow}</span>
        <h1 id="converter-heading">{converter.hero.heading}<br /><em>{converter.hero.accent}</em></h1>
        <p>{converter.hero.intro}</p>
      </div>
      <LocalVideoTool client:only="react" mode="converter" copy={tool} />
    </section>
    <section class="utility-notes" aria-labelledby="converter-notes-heading">
      <div><span class="eyebrow">{converter.notesEyebrow}</span><h2 id="converter-notes-heading">{converter.notesHeading}</h2></div>
      <ul>{converter.notes.map((note) => <li>{note}</li>)}</ul>
    </section>
  </div>
</SiteLayout>
