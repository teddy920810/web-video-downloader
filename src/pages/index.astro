---
import DownloaderHome from '../components/products/DownloaderHome.astro';
import UtilitiesHome from '../components/products/UtilitiesHome.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = false;
const mode = Astro.locals.siteMode;
const utilities = mode === 'utilities';
---

<SiteLayout siteMode={mode} showAuth={!utilities} title={utilities ? 'Streamnest Video Tools – Local Converter and Compressor' : 'Video Downloader – Download public videos in 720p'} description={utilities ? 'Convert and compress local video files directly in your browser without uploading them to a server.' : 'Analyze public YouTube, TikTok, and Instagram videos, then download one trial file in up to 720p.'}>
  {utilities ? <UtilitiesHome /> : <DownloaderHome />}
</SiteLayout>
