---
import UrlDownloader from '../components/downloader/UrlDownloader';
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = true;
---

<SiteLayout title="Video Downloader – Download public videos in 720p" description="Analyze public YouTube, TikTok, and Instagram videos, then download one trial file in up to 720p.">
  <section class="hero download-hero">
    <div class="hero-copy">
      <span class="eyebrow">Simple · Private · One free trial</span>
      <h1>Save public videos<br /><em>without the clutter.</em></h1>
      <p>Paste a link from YouTube, TikTok, or Instagram. We’ll analyze the available formats, then let you download one file after signing in.</p>
      <div class="trust-row"><span>✓ No install required</span><span>✓ Up to 720p</span><span>✓ Files deleted after 24 hours</span></div>
    </div>
    <div id="tool" class="hero-tool"><UrlDownloader client:load /></div>
  </section>

  <section class="download-proof" aria-label="How the trial works">
    <article><span>01</span><h2>Paste a link</h2><p>Start with a public, individual video URL from a supported platform.</p></article>
    <article><span>02</span><h2>Choose a format</h2><p>Sign in to see permitted video or audio options within the free-trial limits.</p></article>
    <article><span>03</span><h2>Download safely</h2><p>Your finished file is delivered through a temporary private link.</p></article>
  </section>

  <section class="section trial-section" id="how-it-works">
    <div><span class="eyebrow">Built for a quick try</span><h2>A focused web trial, not an unlimited downloader.</h2><p>Each account gets one download, limited to public video, 720p, 10 minutes, and 500 MB. This keeps the service quick, fair, and easy to use.</p></div>
    <ul><li>Only content you have the right to download</li><li>No playlists, private posts, accounts, or DRM content</li><li>Automatic deletion after 24 hours</li></ul>
  </section>
</SiteLayout>
