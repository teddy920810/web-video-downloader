---
import LocalVideoTool from '../components/media/LocalVideoTool';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;
const [entry] = await getCollection('utilitiesSettings');
if (!entry) throw new Error('Utilities CMS settings are missing.');
const { compressor, tool } = entry.data;
---

<SiteLayout siteMode={Astro.locals.siteMode} title={compressor.meta.title} description={compressor.meta.description}>
  <div class="utility-page">
    <section class="utility-hero" aria-labelledby="compressor-heading">
      <div class="utility-hero-copy">
        <span class="eyebrow">{compressor.hero.eyebrow}</span>
        <h1 id="compressor-heading">{compressor.hero.heading}<br /><em>{compressor.hero.accent}</em></h1>
        <p>{compressor.hero.intro}</p>
      </div>
      <LocalVideoTool client:only="react" mode="compressor" copy={tool} />
    </section>
    <section class="utility-notes" aria-labelledby="compressor-notes-heading">
      <div><span class="eyebrow">{compressor.notesEyebrow}</span><h2 id="compressor-notes-heading">{compressor.notesHeading}</h2></div>
      <ul>{compressor.notes.map((note) => <li>{note}</li>)}</ul>
    </section>
  </div>
</SiteLayout>
