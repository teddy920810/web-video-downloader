---
import { getCollection } from 'astro:content';
import LocalImageTool from '../components/image/LocalImageTool';
import UtilityToolPage from '../components/products/UtilityToolPage.astro';
export const prerender = false;
const [entry] = await getCollection('utilitiesSettings');
if (!entry) throw new Error('Utilities CMS settings are missing.');
const page = entry.data.toolPages['image-converter'];
---
<UtilityToolPage page={page} siteMode={Astro.locals.siteMode} headingId="image-converter-heading"><LocalImageTool client:only="react" mode="converter" heading="Convert a local image" /></UtilityToolPage>
