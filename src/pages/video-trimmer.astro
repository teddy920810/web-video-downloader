---
import { getCollection } from 'astro:content';
import LocalVideoTool from '../components/media/LocalVideoTool';
import UtilityToolPage from '../components/products/UtilityToolPage.astro';
export const prerender = false;
const [entry] = await getCollection('utilitiesSettings');
if (!entry) throw new Error('Utilities CMS settings are missing.');
const page = entry.data.toolPages['video-trimmer'];
---
<UtilityToolPage page={page} siteMode={Astro.locals.siteMode} headingId="video-trimmer-heading"><LocalVideoTool client:only="react" mode="trimmer" copy={entry.data.tool} heading="Trim a local video" /></UtilityToolPage>
