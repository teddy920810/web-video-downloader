---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { buildCollectionPageSchema } from '../../lib/content/seo-schema';

export const prerender = false;

const [posts, blogSettingsEntries, siteEntries] = await Promise.all([
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('blogIndexSettings'),
  getCollection('siteSettings'),
]);
const [blogSettings] = blogSettingsEntries;
const [siteEntry] = siteEntries;
if (!blogSettings || !siteEntry) throw new Error('Blog or site CMS settings are missing.');

const publishedPosts = posts.sort((left, right) => right.data.publishedAt.localeCompare(left.data.publishedAt));
const visiblePosts = publishedPosts.slice(0, blogSettings.data.postsPerPage);
const categories = [...new Set(visiblePosts.map((post) => post.data.category ?? siteEntry.data.contentDefaults.category))]
  .sort((left, right) => left.localeCompare(right));
const schema = buildCollectionPageSchema({
  canonicalOrigin: siteEntry.data.canonicalOrigin,
  path: '/blog',
  name: blogSettings.data.heading,
  description: blogSettings.data.description,
});
---

<SiteLayout title={blogSettings.data.title} description={blogSettings.data.description} image={blogSettings.data.shareImage} schema={schema}>
  <header class="blog-hero">
    <span class="eyebrow">{blogSettings.data.eyebrow}</span>
    <h1>{blogSettings.data.heading}</h1>
    <p>{blogSettings.data.intro}</p>
  </header>

  {visiblePosts.length > 0 && (
    <section class="blog-filter-bar" aria-label="Filter guides by category">
      <div class="blog-filters">
        <button class="blog-filter" type="button" data-blog-filter="all" aria-pressed="true">All guides</button>
        {categories.map((category) => (
          <button class="blog-filter" type="button" data-blog-filter={category} aria-pressed="false">{category}</button>
        ))}
      </div>
      <p class="blog-results" data-blog-results aria-live="polite">{visiblePosts.length} guides</p>
    </section>
  )}

  <section class="blog-list" aria-label="Published guides">
    {visiblePosts.length > 0 ? visiblePosts.map((post) => (
      <article class:list={{ 'blog-card': true, 'has-cover': Boolean(post.data.coverImage) }} data-blog-card data-category={post.data.category ?? siteEntry.data.contentDefaults.category}>
        {post.data.coverImage && <img class="blog-card-image" src={post.data.coverImage} alt={post.data.coverAlt ?? ''} width="1200" height="675" loading="lazy" />}
        <div class="blog-card-copy">
          <span class="article-category">{post.data.category ?? siteEntry.data.contentDefaults.category}</span>
          <h2><a href={`/blog/${post.data.slug}`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <small>{post.data.publishedAt} · {post.data.readTime}</small>
        </div>
      </article>
    )) : (
      <div class="blog-empty"><strong>New guides are on the way.</strong><p>Check back soon for practical video downloading tips.</p></div>
    )}
  </section>
  <script>
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]')];
    const blogCards = [...document.querySelectorAll<HTMLElement>('[data-blog-card]')];
    const results = document.querySelector<HTMLElement>('[data-blog-results]');

    const applyCategory = (category: string, updateUrl = true) => {
      const selected = filterButtons.some((button) => button.dataset.blogFilter === category) ? category : 'all';
      let visibleCount = 0;

      filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.blogFilter === selected)));
      blogCards.forEach((card) => {
        const visible = selected === 'all' || card.dataset.category === selected;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      if (results) results.textContent = `${visibleCount} ${visibleCount === 1 ? 'guide' : 'guides'}`;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (selected === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', selected);
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }
    };

    filterButtons.forEach((button) => button.addEventListener('click', () => applyCategory(button.dataset.blogFilter ?? 'all')));
    applyCategory(new URLSearchParams(window.location.search).get('category') ?? 'all', false);
  </script>
</SiteLayout>
