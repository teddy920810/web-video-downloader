---
import '../styles/global.css';
import AuthControls from '../components/auth/AuthControls';
import SocialIcon from '../components/icons/SocialIcon';
import { getCollection } from 'astro:content';
import type { SiteMode } from '../lib/config/site-mode';
import { filterPostsForMode } from '../lib/content/mode-public-content';
import { TOOL_GROUPS, TOOLS } from '../lib/product/catalog';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  showAuth?: boolean;
  siteMode?: SiteMode;
}

const [siteEntries, allPosts] = await Promise.all([
  getCollection('siteSettings'),
  getCollection('blog'),
]);
const [siteEntry] = siteEntries;
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const site = siteEntry.data;

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  image = site.defaultShareImage,
  type = 'website',
  schema,
  noindex = false,
  showAuth = true,
  siteMode = Astro.locals.siteMode ?? 'downloader',
} = Astro.props;
const utilitiesMode = siteMode === 'utilities';
const displayName = site.name;
const hasVisibleBlogPosts = filterPostsForMode(allPosts, siteMode).some((post) => !post.data.draft);
type NavigationItem = {
  label: string;
  href: string;
  children?: Array<{ label: string; href: string }>;
  groups?: typeof TOOL_GROUPS;
};
const toolsMenu: NavigationItem = { label: 'Tools', href: '/#tools', groups: TOOL_GROUPS };
const navigation: NavigationItem[] = utilitiesMode ? [
  toolsMenu,
  { label: 'Pricing', href: '/pricing' },
  { label: 'Account', href: '/account' },
  ...(hasVisibleBlogPosts ? [{ label: 'Guides', href: '/blog' }] : []),
  { label: 'Desktop App', href: '/#desktop-app' },
  { label: 'Privacy', href: '/privacy' },
] : [
  ...site.header.navigation,
  toolsMenu,
  { label: 'Pricing', href: '/pricing' },
  { label: 'Account', href: '/account' },
];
const footerResources = [
  ...site.footer.links,
  ...(hasVisibleBlogPosts ? [{ label: 'Guides', href: '/blog' }] : []),
];
const footerVideoAudioTools = TOOLS.filter((tool) => tool.category === 'video' || tool.category === 'audio');
const footerImageTools = TOOLS.filter((tool) => tool.category === 'image');
const legalLinks = [
  { label: 'Refund Policy', href: '/refund-policy' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Use', href: '/terms' },
];
const footerTagline = site.footer.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const configuredAnalyticsId = site.analytics.googleMeasurementId;
const analyticsId = Astro.url.origin === new URL(site.canonicalOrigin).origin
  ? configuredAnalyticsId
  : '';
const showConsentControls = Boolean(configuredAnalyticsId);
const isDownloaderHome = Astro.url.pathname === '/';
const isDownloaderTheme = !utilitiesMode && (isDownloaderHome || Astro.url.pathname.startsWith('/blog'));
const defaultSchema = {
  '@type': 'WebApplication',
  name: displayName,
  applicationCategory: utilitiesMode ? 'UtilitiesApplication' : site.structuredData.applicationCategory,
  operatingSystem: utilitiesMode ? 'Any browser with WebAssembly support' : site.structuredData.operatingSystem,
  url: canonical.toString(),
  description,
  offers: {
    '@type': 'Offer',
    price: site.structuredData.price,
    priceCurrency: site.structuredData.priceCurrency,
  },
};
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [defaultSchema];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
     {analyticsId && <script is:inline define:vars={{ analyticsId }}>
       window.dataLayer = window.dataLayer || [];
       // Keep Google's official command-queue shape; gtag.js expects the arguments object.
       // eslint-disable-next-line prefer-rest-params
       function gtag(){dataLayer.push(arguments);}
       let storedConsent = null;
       try { storedConsent = localStorage.getItem('streamnest-consent-v1'); } catch {
         // Storage can be unavailable in privacy-restricted browser contexts.
       }
       gtag('consent', 'default', {
         'ad_storage': 'denied',
         'ad_user_data': 'denied',
         'ad_personalization': 'denied',
         'analytics_storage': 'denied',
         'wait_for_update': 500,
       });
       if (storedConsent === 'analytics') {
         gtag('consent', 'update', {
           'ad_storage': 'denied',
           'ad_user_data': 'denied',
           'ad_personalization': 'denied',
           'analytics_storage': 'granted',
         });
       }
       gtag('js', new Date());
       gtag('config', analyticsId);
    </script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href={site.favicon} />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
  </head>
  <body class:list={{ 'download-site': isDownloaderTheme, 'utility-site': utilitiesMode }} style={`--theme-color: ${site.themeColor}; --theme-color-fallback: ${site.themeColorFallback};`}>
    {!utilitiesMode && site.announcement.enabled && (
      <aside class="site-announcement" aria-label="Site announcement">
        <span>{site.announcement.text}</span>
        {site.announcement.linkLabel && site.announcement.linkHref && <a href={site.announcement.linkHref}>{site.announcement.linkLabel} →</a>}
      </aside>
    )}
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${displayName} home`}><img class="brand-logo" src={site.logo} alt="" /><span>{displayName}</span></a>
      <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false" data-mobile-menu-toggle>
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <nav id="site-navigation" aria-label="Main navigation">
        {navigation.map((item, index) => ((item.groups?.length ?? 0) > 0 || (item.children?.length ?? 0) > 0) ? (
          <div class="nav-dropdown">
            <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls={`nav-dropdown-${index}`} data-nav-dropdown-trigger>{item.label}<span aria-hidden="true">⌄</span></button>
            <div class:list={['nav-dropdown-panel', { 'nav-dropdown-mega': item.groups }]} id={`nav-dropdown-${index}`}>
              {item.groups ? TOOL_GROUPS.map((group) => (
                <section class="nav-dropdown-group" aria-labelledby={`tool-group-${group.id}`}>
                  <span class="nav-dropdown-group-title" id={`tool-group-${group.id}`}>{group.label}</span>
                  {group.tools.map((tool) => <a href={tool.route}>{tool.label}</a>)}
                </section>
              )) : (item.children ?? []).map((child) => <a href={child.href}>{child.label}</a>)}
            </div>
          </div>
        ) : <a href={item.href}>{item.label}{item.href.endsWith('#desktop-app') && <span class="nav-coming-soon">Coming soon</span>}</a>)}
      </nav>
      {showAuth && <div class="header-auth"><AuthControls client:load /></div>}
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><a class="brand" href="/"><img class="brand-logo" src={site.logo} alt="" /><span>{displayName}</span></a><p>{footerTagline}</p>
        {site.footer.socialLinks.length > 0 && <div class="footer-social-links" aria-label="Social media">
          {site.footer.socialLinks.map((social) => <a href={social.href} aria-label={social.label} title={social.label} target="_blank" rel="noreferrer"><SocialIcon platform={social.platform} /></a>)}
        </div>}
      </div>
      <div class="footer-tool-groups">
        <section class="footer-link-group"><h2>Video & audio tools</h2>{footerVideoAudioTools.map((tool) => <a href={tool.route}>{tool.label}</a>)}</section>
        <section class="footer-link-group"><h2>Image tools</h2>{footerImageTools.map((tool) => <a href={tool.route}>{tool.label}</a>)}</section>
        <section class="footer-link-group"><h2>Resources</h2>{footerResources.map((item) => <a href={item.href}>{item.label}</a>)}</section>
         <section class="footer-link-group"><h2>Legal</h2>{legalLinks.map((item) => <a href={item.href}>{item.label}</a>)}{showConsentControls && <button class="footer-cookie-settings" type="button" data-cookie-settings>Cookie settings</button>}</section>
       </div>
       <p class="footer-copyright">© {new Date().getFullYear()} {displayName}. All rights reserved.</p>
     </footer>
     {showConsentControls && (
       <aside class="cookie-consent" role="dialog" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-description" data-cookie-consent hidden>
         <div>
           <h2 id="cookie-consent-title">Your privacy choices</h2>
           <p id="cookie-consent-description">We use optional Google Analytics to understand how Streamnest is used. Necessary storage keeps sign-in and core features working.</p>
         </div>
         <div class="cookie-consent-actions">
           <button class="button-secondary" type="button" data-consent-necessary>Necessary only</button>
           <button class="button-primary" type="button" data-consent-accept>Accept analytics</button>
         </div>
       </aside>
     )}
     <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const dropdownTriggers = document.querySelectorAll<HTMLButtonElement>('[data-nav-dropdown-trigger]');

      const closeDropdowns = () => dropdownTriggers.forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.closest('.nav-dropdown')?.classList.remove('is-open');
      });
      const closeMenu = () => {
        header?.classList.remove('is-menu-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuToggle?.setAttribute('aria-label', 'Open navigation');
        closeDropdowns();
      };

      menuToggle?.addEventListener('click', () => {
        const open = !header?.classList.contains('is-menu-open');
        header?.classList.toggle('is-menu-open', open);
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        if (!open) closeDropdowns();
      });

      dropdownTriggers.forEach((trigger) => trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const dropdown = trigger.closest('.nav-dropdown');
        const open = trigger.getAttribute('aria-expanded') !== 'true';
        closeDropdowns();
        trigger.setAttribute('aria-expanded', String(open));
        dropdown?.classList.toggle('is-open', open);
      }));

      dropdownTriggers.forEach((trigger) => {
        const dropdown = trigger.closest('.nav-dropdown');
        if (!(dropdown instanceof HTMLElement)) return;
        dropdown.addEventListener('pointerleave', (event) => {
          if (event.pointerType !== 'mouse') return;
          trigger.setAttribute('aria-expanded', 'false');
          dropdown.classList.remove('is-open');
          trigger.blur();
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
          menuToggle?.focus();
        }
      });
      header?.addEventListener('click', (event) => event.stopPropagation());
       document.addEventListener('click', closeMenu);

       const consentBanner = document.querySelector<HTMLElement>('[data-cookie-consent]');
       const consentSettings = document.querySelector<HTMLButtonElement>('[data-cookie-settings]');
       const acceptAnalytics = document.querySelector<HTMLButtonElement>('[data-consent-accept]');
       const necessaryOnly = document.querySelector<HTMLButtonElement>('[data-consent-necessary]');
       const consentStorageKey = 'streamnest-consent-v1';
       type ConsentChoice = 'analytics' | 'necessary';
       const readConsentChoice = (): ConsentChoice | null => {
         try {
           const choice = localStorage.getItem(consentStorageKey);
           return choice === 'analytics' || choice === 'necessary' ? choice : null;
         } catch {
           return null;
         }
       };
       const updateConsent = (choice: ConsentChoice) => {
         try { localStorage.setItem(consentStorageKey, choice); } catch {
           // Apply the in-page choice even when persistent storage is unavailable.
         }
         const analyticsWindow = window as Window & { gtag?: (...args: unknown[]) => void };
         analyticsWindow.gtag?.('consent', 'update', {
           'ad_storage': 'denied',
           'ad_user_data': 'denied',
           'ad_personalization': 'denied',
           'analytics_storage': choice === 'analytics' ? 'granted' : 'denied',
         });
         if (consentBanner) consentBanner.hidden = true;
       };
       if (consentBanner && !readConsentChoice()) consentBanner.hidden = false;
       consentSettings?.addEventListener('click', () => {
         if (consentBanner) {
           consentBanner.hidden = false;
           (readConsentChoice() === 'analytics' ? acceptAnalytics : necessaryOnly)?.focus();
         }
       });
       acceptAnalytics?.addEventListener('click', () => updateConsent('analytics'));
       necessaryOnly?.addEventListener('click', () => updateConsent('necessary'));
     </script>
  </body>
</html>

